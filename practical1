import 'dart:io';
import 'dart:async';

Future<void> main() async 
{
  stdout.write("Enter total days: ");
  int totalDays = int.parse(stdin.readLineSync()!);

  stdout.write("Enter present days: ");
  int presentDays = int.parse(stdin.readLineSync()!);

  int absentDays = totalDays - presentDays;
  double percentage = (presentDays / totalDays) * 100;

  print("Processing attendance...");
  await Future.delayed(Duration(seconds: 1));

  print("\n--- Attendance Report ---");
  print("Total Days: $totalDays");
  print("Present Days: $presentDays");
  print("Absent Days: $absentDays");
  print("Attendance: ${percentage.toStringAsFixed(2)}%");

  if (percentage >= 75)
  {
    print("Exam Eligibility: Eligible");
  } 
  else
  {
    print("Exam Eligibility: Not Eligible");
  }
}
